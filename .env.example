# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe Configuration
# Get your publishable key from Stripe Dashboard
VITE_STRIPE_PUBLIC_KEY=pk_test_your_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# API Configuration
# Backend API URL - OAuth callbacks and API requests will use this
# Local development: http://localhost:5000
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:5000

# OAuth Flow Explanation
# 1. User clicks "Sign in with Google/GitHub" on frontend
# 2. Frontend redirects to Supabase OAuth with redirectTo: http://localhost:5000/api/auth/callback (backend)
# 3. After OAuth approval, Supabase redirects to backend: GET /api/auth/callback?code=XXX
# 4. Backend validates code and redirects to frontend: http://localhost:54336/auth/callback?code=XXX
# 5. Frontend receives code in /auth/callback page
# 6. Frontend calls backend: POST /api/auth/verify-code with the code
# 7. Frontend is authenticated and redirected to dashboard

# Add these OAuth redirect URLs in Supabase Dashboard:
# 1. Development: http://localhost:5000/api/auth/callback (backend callback)
# 2. Development: http://localhost:54336/auth/callback (frontend callback - not used by Supabase directly)
# 3. Production: https://pdf-ocr-api-s4p9.onrender.com/api/auth/callback (backend callback)
# 4. Production: https://pdf-ocr-frontend.onrender.com/auth/callback (frontend callback - not used by Supabase directly)

